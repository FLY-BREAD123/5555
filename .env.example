# ===== 필수 =====
# 디스코드 개발자 포털 → Bot → Reset Token
DISCORD_TOKEN=

# MongoDB Atlas 연결 주소 (Render에선 꼭 필요! 없으면 재시작 때 백업이 다 사라짐)
# 예: mongodb+srv://아이디:비밀번호@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# ===== 추천 =====
# 내 디스코드 유저 ID (쉼표로 여러 명). 모든 백업 열람/복구 가능 + 테러 알림 DM 받음
BOT_OWNER_IDS=

# ===== 선택 (안 넣으면 기본값) =====
# 봇이 새 서버에 들어가면 자동백업 자동으로 켜기 (true/false)
AUTO_BACKUP_DEFAULT=true
# 자동백업 주기(시간) / 보관 개수 / 채널당 저장할 메시지 수
AUTO_BACKUP_HOURS=6
AUTO_BACKUP_KEEP=10
BACKUP_MESSAGES=20
# 서버당 수동 백업 최대 개수 / 포럼 채널당 저장할 게시글 수
MAX_MANUAL_BACKUPS=20
BACKUP_FORUM_POSTS=15
# 테러 감지 기준 (60초 안에 이만큼 지워지면 알림)
GUARD_CHANNEL_DELETES=5
GUARD_ROLE_DELETES=5
GUARD_BANS=8
# 복구 후 다시 들어온 멤버에게 원래 역할 주는 기간(일)
REJOIN_ROLE_DAYS=30
# 자동완성에 표시할 시간대
TZ_DISPLAY=Asia/Seoul
# MongoDB 데이터베이스 이름
MONGODB_DB=darkbackup
